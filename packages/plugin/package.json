{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@kx/plugin",
  "version": "1.3.2",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "tsc",
    "lint": "eslint src"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tool": "./src/tool.ts"
  },
  "dependencies": {
    "@kx/sdk": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.1.91",
    "@opentui/solid": ">=0.1.91"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@kx/config-eslint": "workspace:*"
  }
}
